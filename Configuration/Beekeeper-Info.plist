<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>HivePairingMachService</key>
	<string>$(HIVE_BUNDLE_ID).Pairing</string>
	<key>HiveDaemonSigningIdentifier</key>
	<string>$(HIVE_BUNDLE_ID).Daemon</string>
	<key>HiveBundleIdentifier</key>
	<string>$(HIVE_BUNDLE_ID)</string>
	<!--
	Set only by Scripts/release.sh for TestFlight builds, which expire 90 days after upload, so
	Beekeeper can work out when it expires. Empty in every other build.
	-->
	<key>BeekeeperBuildDate</key>
	<string>$(BEEKEEPER_BUILD_DATE)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Beekeeper connects to your Hives over your local network to manage your backups.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Beekeeper asks for Face ID before a change that removes backups, sends a password somewhere new, or lets a new device manage a Hive.</string>
	<key>NSCameraUsageDescription</key>
	<string>Beekeeper uses the camera to scan the QR code that pairs this device with a Hive.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_hive._tcp</string>
	</array>
	<key>SUFeedURL</key>
	<string>https://$(UPDATES_SITE)/appcasts/beekeeper.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(UPDATES_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!--
	ATS runs the system's trust check even after PinnedTaskDelegate accepts the Hive's pinned key, and
	refuses its self-signed certificate at any address but loopback and private LAN ranges, such as
	Tailscale's. Exception domains can't name IP addresses or hosts the user types in, so ATS is off.
	HiveAddress only builds https URLs, and HiveConnection requires TLS 1.3.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
