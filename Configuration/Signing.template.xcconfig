// Copy this file to Signing.local.xcconfig in this folder and fill in both values. Git ignores the copy.

// Your Apple Developer team ID, shown under Membership details at developer.apple.com/account.
DEVELOPMENT_TEAM =

// The start of every bundle ID, such as com.example. Hive's is <prefix>.Hive and Beekeeper's is
// <prefix>.HiveBeekeeper.
BUNDLE_ID_PREFIX =

// Where the Mac apps look for updates, without https://, such as example.github.io/hive. Leave both of
// these empty to build copies that never update themselves, so a copy you build is never replaced by
// one signed by someone else.
UPDATES_SITE =

// The public half of the Sparkle signing key, as printed by Scripts/sparkle-tools.sh generate_keys -p.
UPDATES_PUBLIC_KEY =
